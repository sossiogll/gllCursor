{
  "name": "@sossiogll/gll-cursor-react",
  "version": "0.2.0",
  "description": "A cursor that changes shape with what is under it, for React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sossiogll/gllCursor.git",
    "directory": "react"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cursor.css": "./dist/cursor.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/core/cursor.css dist/cursor.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
